# Salida de compilación (se regenera con cmake)
CMake/Build/
CMake/out/
CMake/.vs/
compile_commands.json

# Ficheros generados al ejecutar la aplicación
*.log
*.zip

# Claves y certificados PROPIOS: nunca al repositorio.
# (Los certificados de prueba del ejemplo de GEN sí se incluyen porque ya son públicos.)
*.key
*.p12
*.pfx
assets/certificates/private/

# Configuración local con valores reales (credenciales, IPs de casa): nunca al repositorio.
*.local.ini

# Claves privadas propias en PEM/HEX. Las de ejemplo de GEN ya están versionadas
# y git las sigue igualmente; esto solo evita añadir por error claves nuevas.
*_key.pem
*_priv.hex

# Tests de la web (Playwright): dependencias e informes generados
Tests/Web/node_modules/
Tests/Web/test-results/
Tests/Web/playwright-report/
